{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clip Resizer",
  "version": "0.2.0",
  "identifier": "com.clipresizer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1437",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clip Resizer",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0e1117"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost clipthumb: http://clipthumb.localhost data: blob:; media-src 'self' asset: http://asset.localhost clipvid: http://clipvid.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": {
      "../vendor/ffmpeg/bin/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "../vendor/ffmpeg/bin/ffprobe.exe": "ffmpeg/ffprobe.exe"
    },
    "category": "Video",
    "shortDescription": "Local video resizing and social-media formatting studio",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
